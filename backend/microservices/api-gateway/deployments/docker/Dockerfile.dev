FROM golang:1.21-alpine

WORKDIR /app

# Install development tools
RUN apk add --no-cache git gcc musl-dev make

# Install air for hot reload
RUN go install github.com/cosmtrek/air@latest

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Expose port
EXPOSE 8000

# Run with air
CMD ["air", "-c", ".air.toml"]