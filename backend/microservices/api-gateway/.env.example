# ============================================
# API GATEWAY CONFIGURATION
# ============================================

# Server Configuration
SERVICE_PORT=8000
DEBUG=true
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRATION=24h

# Redis Configuration
REDIS_URL=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# ============================================
# MICROSERVICES URLs
# ============================================

# Core Services
USER_SERVICE_URL=http://user-service:8001
AUTH_SERVICE_URL=http://auth-service:8002

# Course & Learning Services
COURSES_SERVICE_URL=http://courses-service:8003
ENROLLMENT_SERVICE_URL=http://enrollment-service:8004
QUIZZES_SERVICE_URL=http://quizzes-service:8005

# Payment & Booking Services
PAYMENTS_SERVICE_URL=http://payments-service:8006
BOOKINGS_SERVICE_URL=http://bookings-service:8007

# Communication Services
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8008
COMMUNICATIONS_SERVICE_URL=http://communications-service:8009
CHATBOT_SERVICE_URL=http://chatbot-service:8010

# Analytics & Monitoring Services
ANALYTICS_SERVICE_URL=http://analytics-service:8011
MONITORING_SERVICE_URL=http://monitoring-service:8012

# Utility Services
SEARCH_SERVICE_URL=http://search-service:8013
CACHE_SERVICE_URL=http://cache-service:8014
STORAGE_SERVICE_URL=http://storage-service:8015

# Advanced Features Services
GAMIFICATION_SERVICE_URL=http://gamification-service:8016
REVIEWS_SERVICE_URL=http://reviews-service:8017
WEBINARS_SERVICE_URL=http://webinars-service:8018

# Business Services
SPONSORS_SERVICE_URL=http://sponsors-service:8019

# Additional Services
I18N_SERVICE_URL=http://i18n-service:8020
SECURITY_SERVICE_URL=http://security-service:8021