# Server Configuration
PORT=9090
MODE=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=monitoring
DB_PASSWORD=monitoring_password
DB_NAME=monitoring_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Services to Monitor (comma-separated)
SERVICES_TO_MONITOR=api-gateway:8000,user-service:8001,payment-service:8002

# Monitoring Configuration
CHECK_INTERVAL=30
ALERT_THRESHOLD=3
