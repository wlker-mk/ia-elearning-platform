# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://enrollments_user:enrollments_pass@localhost:5432/enrollments_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Service URLs
COURSES_SERVICE_URL=http://localhost:8001
USERS_SERVICE_URL=http://localhost:8002
PAYMENTS_SERVICE_URL=http://localhost:8003

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email (optional for certificates)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Certificate Settings
CERTIFICATE_DOMAIN=https://yourdomain.com
CERTIFICATE_STORAGE_PATH=certificates/

# Monitoring (optional)
SENTRY_DSN=

# File Storage
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Logging
LOG_LEVEL=INFO